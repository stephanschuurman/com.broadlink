    {
      "id": "rm4m-receive-hex",
      "title": {
        "en": "Start recording mode",
        "nl": "Start opname-modus"
      },
      "titleFormatted": {
        "en": "Start recording mode to Hex, Base64 and Pronto with [[normalize]]",
        "nl": "Start opname-modus naar Hex, Base64 en Pronto met [[normalize]]"
      },
      "hint": {
        "en": "Start the IR learning mode. The device waits for an IR signal and returns the result as Broadlink Hex, Base64 and Pronto hex. Normalization removes the lead-in and repeated bursts, quantizes the timings and sets the type byte to 0x26; turn it off to get the raw capture in every token.",
        "nl": "Start de IR-leermodus. Het apparaat wacht op een IR-signaal en geeft het resultaat terug als Broadlink Hex, Base64 en Pronto hex. Normalisatie verwijdert de lead-in en herhaalde bursts, kwantiseert de timing en zet de type-byte op 0x26; zet dit uit om in alle tokens de rauwe opname te krijgen."
      },
      "args": [
        {
          "name": "normalize",
          "type": "dropdown",
          "title": {
            "en": "Normalization",
            "nl": "Normalisatie"
          },
          "values": [
            {
              "id": "on",
              "label": {
                "en": "normalization on",
                "nl": "normalisatie aan"
              }
            },
            {
              "id": "off",
              "label": {
                "en": "normalization off (raw)",
                "nl": "normalisatie uit (rauw)"
              }
            }
          ]
        }
      ],
      "tokens": [
        {
          "name": "ir_result_hex",
          "type": "string",
          "title": {
            "en": "IR Result Broadlink Hex",
            "nl": "IR Resultaat Broadlink Hex"
          },
          "example": {
            "en": "26001a001d1d3a3a1d1d1d1d1d1d1d1d3a1d1d1d1d1d1d1d1d3a1d000b870d05"
