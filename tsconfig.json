{
  "extends": "@tsconfig/node24/tsconfig.json",
  "compilerOptions": {
    "outDir": ".homeybuild/",
    "sourceMap": true,
    "module": "Node16", // commonjs
    "moduleResolution": "Node16",
    "types": ["node"],
    "strict": false,
    "esModuleInterop": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  "devDependencies": {
    "@types/node": "^24.14.1"
  },
  "include": [
    "lib/Communicate.ts",
    "lib/BroadlinkPackages.ts",
    "lib/BroadLink/protocol/**/*.ts",
    "lib/BroadLink/types/payload-type.ts", 
    "lib/BroadLink/protocol/demo.js" 
  ]
}
